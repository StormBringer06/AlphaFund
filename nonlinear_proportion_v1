
"""
V3 pairs trading with a variance-normalized EWMA signal.

Signal:
    z_t = (spread_t - EWMA_mean_{t-1}) / EWMA_variance_{t-1}

Base position:
    clip(-z_t / full_exposure_zscore, -1, 1)

V3 features:
    - EWMA half-life: 120 trading days
    - Fixed no-trade band: 0.2
    - VIX position overlay: 0 or 0.25
    - No VIX scaling of the trading band
    - Point-in-time screened pairs
    - Yearly walk-forward parameter selection

The VIX parameter is selected using an inner walk-forward
over the four years preceding each test year.

Results are gross of fees by default. A secondary table
re-costs the same positions at --net-cost-bps.

The original EWMA and naive z-score models are retained
as benchmarks.
"""

from __future__ import annotations

import argparse
import math
from pathlib import Path

import numpy as np
import pandas as pd

from backtest import (
    apply_positions_to_returns,
    run_walk_forward_backtest,
    summarize_backtest,
)

from base_model import NaivePairsTradingModel

from improved_models.regression_model import portfolio_metrics

from improved_models.vol_scaled_naive_model import (
    VolScaledNaivePairsTradingModel,
    robustness_table,
)


# ============================================================
# Variance-normalized model
# ============================================================

class VarianceScaledNaivePairsTradingModel(
    VolScaledNaivePairsTradingModel
):
    """
    V3 model using inverse-variance normalization.

    Original:
        z = (spread - EWMA_mean) / EWMA_std

    Modified:
        z = (spread - EWMA_mean) / EWMA_variance

    All other model behavior is inherited:
        - OLS hedge-ratio estimation
        - Six-month hedge-ratio refitting
        - VIX position multiplier
        - No-trade band
        - Gross-exposure constraints
        - Pair-leg position allocation
    """

    def _features(self, frame, hedge):

        # Preserve the original spread, hedge-ratio,
        # and VIX percentile calculations.
        out = super()._features(frame, hedge)

        spread = out["spread"]

        # EWMA using the original 120-day half-life.
        ewm = spread.ewm(
            halflife=self.zscore_halflife,
            min_periods=int(self.zscore_halflife),
        )

        # Shift by one day to avoid look-ahead bias.
        ewma_mean = ewm.mean().shift(1)
        ewma_variance = ewm.var().shift(1)

        # Protect against division by zero.
        safe_variance = ewma_variance.where(
            ewma_variance > 1e-12
        )

        # NEW SIGNAL:
        # z_t = (S_t - mu_{t-1}) / sigma_{t-1}^2
        out["spread_zscore"] = (
            (spread - ewma_mean) / safe_variance
        )

        return out


# ============================================================
# V3 parameter grid
# ============================================================

V3_GRID = {
    "vix_scale": (0.0, 0.25),
    "band": (0.2,),
    "band_vix_scale": (0.0,),
}


# ============================================================
# Portfolio Sharpe ratio
# ============================================================

def portfolio_sharpe(daily: pd.DataFrame) -> float:
    """
    Equal-weight portfolio Sharpe across all pairs.
    """

    returns = (
        daily.groupby("date")["strategy_return"]
        .mean()
    )

    volatility = float(returns.std())

    if not math.isfinite(volatility) or volatility <= 0:
        return -math.inf

    return float(
        returns.mean()
        / volatility
        * math.sqrt(252.0)
    )


# ============================================================
# Walk-forward parameter selection
# ============================================================

def select_variance_parameters(
    data: pd.DataFrame,
    test_year: int,
    transaction_cost_bps: float,
    train_years: int = 4,
    inner_test_years: int = 2,
    grid: dict = V3_GRID,
):
    """
    Select the VIX scaling parameter for the variance model.

    Uses only observations before the test year.

    Example for test year 2020:

        Parameter-selection window: 2016-2019

        Inner walk-forward:
            Test 2018 using earlier training data.
            Test 2019 using earlier training data.

        Select the configuration with highest
        portfolio Sharpe.

        Apply the selected configuration to 2020.
    """

    if train_years <= inner_test_years:
        raise ValueError(
            "train_years must exceed inner_test_years."
        )

    inner_train_years = train_years - inner_test_years

    # Strictly restrict parameter selection to past data.
    start_date = pd.Timestamp(
        year=test_year - train_years,
        month=1,
        day=1,
    )

    end_date = pd.Timestamp(
        year=test_year,
        month=1,
        day=1,
    )

    train_data = data.loc[
        (data["date"] >= start_date)
        & (data["date"] < end_date)
    ].copy()

    rows = []

    for vix_scale in grid["vix_scale"]:

        params = {
            "vix_scale": float(vix_scale),
            "band": 0.2,
            "band_vix_scale": 0.0,
        }

        model_factory = (
            lambda p=params:
            VarianceScaledNaivePairsTradingModel(**p)
        )

        daily = run_walk_forward_backtest(
            train_data,
            model_factory=model_factory,
            start_year=test_year - inner_test_years,
            end_year=test_year - 1,
            train_years=inner_train_years,
            transaction_cost_bps=transaction_cost_bps,
            model_name="variance_scaled_v3_inner",
        )

        sharpe = portfolio_sharpe(daily)

        rows.append({
            **params,
            "inner_sharpe": sharpe,
        })

    scores = pd.DataFrame(rows)

    best_index = scores["inner_sharpe"].idxmax()

    best = scores.loc[
        best_index,
        ["vix_scale", "band", "band_vix_scale"],
    ].to_dict()

    return (
        {k: float(v) for k, v in best.items()},
        scores,
    )


# ============================================================
# Main backtest
# ============================================================

def main() -> None:

    parser = argparse.ArgumentParser(
        description=__doc__.split("\n\n")[0]
    )

    parser.add_argument(
        "--input",
        type=Path,
        default=Path("data") / "pit_pair_prices.csv",
    )

    parser.add_argument(
        "--selection",
        type=Path,
        default=Path("data") / "pit_pair_selection.csv",
    )

    parser.add_argument(
        "--start-year",
        type=int,
        default=2014,
    )

    parser.add_argument(
        "--end-year",
        type=int,
        default=2023,
    )

    parser.add_argument(
        "--train-years",
        type=int,
        default=4,
    )

    parser.add_argument(
        "--transaction-cost-bps",
        type=float,
        default=0.0,
        help="Cost used for optimization and gross results.",
    )

    parser.add_argument(
        "--net-cost-bps",
        type=float,
        default=5.0,
        help="Cost used for the secondary net comparison.",
    )

    parser.add_argument(
        "--output-dir",
        type=Path,
        default=(
            Path("backtest_results")
            / "vol_scaled_naive_v3_variance"
        ),
    )

    args = parser.parse_args()

    if args.start_year > args.end_year:
        parser.error(
            "--start-year must not exceed --end-year"
        )

    if args.train_years <= 2:
        parser.error(
            "--train-years must be greater than 2"
        )

    # --------------------------------------------------------
    # Load point-in-time data
    # --------------------------------------------------------

    data = pd.read_csv(
        args.input,
        parse_dates=["date"],
    )

    selection = pd.read_csv(args.selection)

    cost = args.transaction_cost_bps

    daily_frames = []
    chosen_parameters = []

    # --------------------------------------------------------
    # Outer walk-forward
    # --------------------------------------------------------

    for fold_id, year in enumerate(
        range(args.start_year, args.end_year + 1),
        start=1,
    ):

        # Select pairs screened for this test year.
        pairs = selection.loc[
            selection["test_year"] == year,
            "pair_id",
        ].unique()

        if len(pairs) == 0:
            raise ValueError(
                f"No selected pairs for test year {year}."
            )

        year_data = data.loc[
            data["pair_id"].isin(pairs)
        ].copy()

        # ----------------------------------------------------
        # Optimize variance model on historical data
        # ----------------------------------------------------

        params, scores = select_variance_parameters(
            data=year_data,
            test_year=year,
            transaction_cost_bps=cost,
            train_years=args.train_years,
            grid=V3_GRID,
        )

        chosen_parameters.append({
            "test_year": year,
            **params,
            "pairs": ",".join(map(str, pairs)),
        })

        print(
            f"{year}: {params} "
            f"pairs: {', '.join(map(str, pairs))}",
            flush=True,
        )

        # ----------------------------------------------------
        # Compare four models
        # ----------------------------------------------------

        models = {

            # Original naive z-score.
            "naive_zscore":
                NaivePairsTradingModel,

            # Original EWMA model.
            "naive_ewma_z":
                VolScaledNaivePairsTradingModel,

            # Original V3 with fixed VIX scale 0.25.
            "original_v3":
                lambda: VolScaledNaivePairsTradingModel(
                    vix_scale=0.25,
                    band=0.2,
                    band_vix_scale=0.0,
                ),

            # NEW variance-normalized V3.
            "variance_scaled_v3":
                lambda p=params:
                    VarianceScaledNaivePairsTradingModel(**p),
        }

        # ----------------------------------------------------
        # Run each model on the same test year
        # ----------------------------------------------------

        for name, factory in models.items():

            daily = run_walk_forward_backtest(
                year_data,
                model_factory=factory,
                start_year=year,
                end_year=year,
                train_years=args.train_years,
                transaction_cost_bps=cost,
                model_name=name,
            )

            daily["fold_id"] = fold_id

            daily_frames.append(daily)

    # ========================================================
    # Combine results
    # ========================================================

    daily = pd.concat(
        daily_frames,
        ignore_index=True,
    )

    # Gross performance.
    comparison = portfolio_metrics(daily)

    # Robustness against original naive model.
    robustness = robustness_table(
        daily,
        baseline="naive_zscore",
    )

    # Net performance on identical positions.
    net_daily = apply_positions_to_returns(
        daily,
        transaction_cost_bps=args.net_cost_bps,
    )

    net_comparison = portfolio_metrics(net_daily)

    # ========================================================
    # Save results
    # ========================================================

    args.output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    suffix = f"_{cost:g}bps"

    daily.to_csv(
        args.output_dir / f"daily_results{suffix}.csv",
        index=False,
    )

    summarize_backtest(daily).to_csv(
        args.output_dir / f"summary{suffix}.csv",
        index=False,
    )

    comparison.to_csv(
        args.output_dir / f"comparison{suffix}.csv",
        index=False,
    )

    robustness.to_csv(
        args.output_dir / f"robustness{suffix}.csv",
        index=False,
    )

    net_comparison.to_csv(
        args.output_dir
        / f"comparison_net_{args.net_cost_bps:g}bps.csv",
        index=False,
    )

    pd.DataFrame(chosen_parameters).to_csv(
        args.output_dir
        / f"selected_parameters{suffix}.csv",
        index=False,
    )

    # ========================================================
    # Print results
    # ========================================================

    with pd.option_context(
        "display.width", 220,
        "display.precision", 3,
    ):

        print(f"\nGross ({cost:g} bps):")
        print(comparison.to_string(index=False))

        print("\nRobustness:")
        print(robustness.to_string(index=False))

        print(
            f"\nNet of {args.net_cost_bps:g} bps "
            "(same positions):"
        )
        print(net_comparison.to_string(index=False))


if __name__ == "__main__":
    main()
